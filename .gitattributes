# Normalise line endings to LF for text files, matching .editorconfig.
* text=auto eol=lf

# Scripts and hooks must keep LF endings to run, whatever a contributor's git settings are.
*.sh text eol=lf
scripts/hooks/* text eol=lf

# Documentation does not count toward the repository's language statistics. Mark
# vendored or generated code the same way, with linguist-vendored or
# linguist-generated, as it appears.
docs/** linguist-documentation
