# Settings every language shares. Indentation is set only where the convention does not
# depend on the language, so a project adds its own language's style below, such as two
# spaces for JavaScript and TypeScript, or tabs for Go.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonl,toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_style = space
indent_size = 4

[{*.sh,scripts/hooks/*}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
