// Dromon driver for Claude Opus 5.5 run through Claude Code, driver interface 1.
//
// The host sends one event per cycle together with the driver's state, and receives
// one action together with the next state. The host stores the state between cycles,
// because the binding does not yet support data segments, and it persists naturally
// in Dromon's event log. Every cycle yields exactly once, so its cost is bounded.
//
// Event:  (tag, text, number)
// State:  (tool uses in the current turn, turns completed)
// Action: (tag, text, number)
//
// Model-specific behaviour is fixed here rather than configured, so a driver states
// exactly which model it was written for and how that model is run.

fn model() -> Text { "claude-opus-5-5" }

fn tool_budget() -> Word { 40 }

// Settings the host reads once, by index, before the first turn. The list ends with
// the tag "end".
fn setting(index: Word) -> (Text, Text, Word) {
    match index {
        0 => ("interface", "", 1),
        1 => ("model", model(), 0),
        2 => ("effort", "high", 0),
        3 => ("max_turns", "", 8),
        4 => ("tool_budget", "", tool_budget()),
        5 => ("context_window", "", 1000000),
        _ => ("end", "", 0),
    }
}

fn on_tool_use(name: Text, tools: Word, turns: Word) -> ((Text, Text, Word), (Word, Word)) {
    let used = tools + 1;
    if used > tool_budget() {
        (("interrupt", "tool_budget", used), (used, turns))
    } else {
        (("continue", name, used), (used, turns))
    }
}

fn on_init(reported: Text, state: (Word, Word)) -> ((Text, Text, Word), (Word, Word)) {
    if reported == model() {
        (("accept", reported, 0), state)
    } else {
        (("refuse", model(), 0), state)
    }
}

loop main(input: ((Text, Text, Word), (Word, Word))) -> ((Text, Text, Word), (Word, Word)) {
    let event = input.0;
    let state = input.1;
    let tag = event.0;
    let tools = state.0;
    let turns = state.1;
    let step = match tag {
        "settings" => (setting(event.2), state),
        "init" => on_init(event.1, state),
        "turn_start" => (("continue", "", 0), (0, turns)),
        "tool_use" => on_tool_use(event.1, tools, turns),
        "result" => (("end_turn", event.1, event.2), (tools, turns + 1)),
        _ => (("continue", "", 0), state),
    };
    let _ = yield step;
    (("idle", "", 0), state)
}
